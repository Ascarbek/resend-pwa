# --- Resend -------------------------------------------------------------
# API key from https://resend.com/api-keys (needs sending + receiving access)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Signing secret of the webhook you create in Resend (Webhooks -> your endpoint)
# Point the webhook at: https://<your-host>/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Default "from" address (must be on your verified domain)
MAIL_FROM="Me <me@example.com>"

# --- Access ---------------------------------------------------------------
# Shared secret the PWA must send (Authorization: Bearer <token>) to use /api/*
ACCESS_TOKEN=change-me

# --- Web Push (generate with: bun run vapid) -------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:me@example.com

# --- Server ---------------------------------------------------------------
PORT=3000
# Directory with the built PWA (apps/web/build) served by the Bun server
STATIC_DIR=../web/build
# JSON file for server-side state (push subscriptions). Relative to apps/server.
DATA_FILE=../../data.json
